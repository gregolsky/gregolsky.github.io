---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  articleDate?: Date;
  articleUpdatedDate?: Date;
}

const {
  title,
  description = 'Software developer, team lead at RavenDB. Writing about code, tools, and things I find interesting.',
  image = '/images/og.png',
  articleDate,
  articleUpdatedDate,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteName = 'Grzegorz Lachowski';
const siteURL = Astro.site!.toString();
const ogImageURL = new URL(image, Astro.site).toString();

const isArticle = Boolean(articleDate);
const isHomepage = Astro.url.pathname === '/';
const isAbout = Astro.url.pathname === '/about' || Astro.url.pathname === '/about/';

const jsonLd = isArticle
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      image: ogImageURL,
      datePublished: articleDate!.toISOString(),
      ...(articleUpdatedDate ? { dateModified: articleUpdatedDate.toISOString() } : {}),
      author: {
        '@type': 'Person',
        name: siteName,
        url: siteURL,
      },
      publisher: {
        '@type': 'Person',
        name: siteName,
        url: siteURL,
      },
      url: canonicalURL.toString(),
    }
  : isAbout
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: siteName,
      url: siteURL,
      jobTitle: 'Software Developer',
      worksFor: { '@type': 'Organization', name: 'RavenDB' },
      sameAs: [
        'https://github.com/gregolsky',
        'https://www.linkedin.com/in/gregolsky/',
      ],
    }
  : isHomepage
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: siteURL,
      description,
      author: {
        '@type': 'Person',
        name: siteName,
      },
    }
  : null;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title === siteName ? title : `${title} — ${siteName}`}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />
    {articleDate && <meta property="article:published_time" content={articleDate.toISOString()} />}
    {articleUpdatedDate && <meta property="article:modified_time" content={articleUpdatedDate.toISOString()} />}
    {isArticle && <meta property="article:author" content="https://www.linkedin.com/in/gregolsky/" />}

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Structured data -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ViewTransitions />

    <!-- Set html.js before first paint so entrance-animation CSS activates -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N7GDB1FP14"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N7GDB1FP14', {
        cookie_domain: 'gregolsky.github.io',
        cookie_flags: 'SameSite=None;Secure'
      });
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- CRT overlay elements -->
    <div class="crt-scanlines" aria-hidden="true"></div>
    <div class="crt-vignette" aria-hidden="true"></div>
    <div class="crt-boot"     aria-hidden="true"></div>

    <slot />

    <script is:inline>
      /* Guard: only wire listeners once across view-transition navigations */
      if (!window._siteInitDone) {
        window._siteInitDone = true;

        var _clockInterval = null;

        function initMediaFrames() {
          document.querySelectorAll('.media-frame').forEach(function(frame) {
            var img = frame.querySelector('img');
            if (!img) return;
            if (img.complete && img.naturalWidth > 0) {
              frame.dataset.loaded = 'true';
              return;
            }
            frame.classList.add('loading');
            img.addEventListener('load', function() {
              frame.classList.remove('loading');
              frame.dataset.loaded = 'true';
            }, { once: true });
          });
        }

        function initScrollAnimations() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('.enter-on-scroll').forEach(function(el) {
              el.classList.add('is-visible');
            });
            return;
          }
          var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          }, { threshold: 0.1 });
          document.querySelectorAll('.enter-on-scroll').forEach(function(el) {
            io.observe(el);
          });
        }

        function initClock() {
          if (_clockInterval) clearInterval(_clockInterval);
          var el = document.querySelector('[data-utc-clock]');
          if (!el) return;
          function tick() {
            var t = new Date();
            el.textContent =
              String(t.getUTCHours()).padStart(2,'0') + ':' +
              String(t.getUTCMinutes()).padStart(2,'0') + ':' +
              String(t.getUTCSeconds()).padStart(2,'0') + ' UTC';
          }
          tick();
          _clockInterval = setInterval(function() {
            /* re-query in case view transition swapped the node */
            el = document.querySelector('[data-utc-clock]');
            if (el) tick();
          }, 1000);
        }

        function triggerBoot() {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          document.body.classList.remove('is-booting');
          void document.body.offsetWidth;
          document.body.classList.add('is-booting');
          setTimeout(function() { document.body.classList.remove('is-booting'); }, 800);
        }

        document.addEventListener('astro:page-load', function() {
          initMediaFrames();
          initScrollAnimations();
          initClock();
          triggerBoot();
        });
      }
    </script>
  </body>
</html>
